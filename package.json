{
  "name": "nigerlan",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "11.19.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm start --workspace @nigerlan/web",
    "dev:api": "npm run dev --workspace @nigerlan/api",
    "start:api": "npm start --workspace @nigerlan/api",
    "build": "npm run build --workspace @nigerlan/web",
    "test": "npm test --workspaces",
    "test:web": "npm test --workspace @nigerlan/web",
    "test:api": "npm test --workspace @nigerlan/api",
    "test:known-defects": "node scripts/verify-defects.mjs",
    "lint": "eslint apps/api apps/web/src scripts .eslintrc.cjs --ext .js,.jsx,.cjs,.mjs --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:dependencies": "npm audit --audit-level=high",
    "security:api": "npm audit --workspace @nigerlan/api --omit=dev --audit-level=high",
    "check:repo": "node scripts/check-repository.mjs",
    "security:install": "node scripts/install-gitleaks.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs"
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "fsevents": false
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "prettier": "3.9.10"
  }
}
